# ===== 师座部署环境变量示例 =====
# 复制为 .env.production 或直接 export 到服务器环境

# 成果目录（生产建议放到代码目录外，如 /var/data/shizuo/artifacts）
# 不设置则默认 <项目目录>/artifacts
ARTIFACTS_DIR=/var/data/shizuo/artifacts

# 应用根目录（部署后一般为代码目录，通常不需要设置）
# APP_ROOT=/opt/shizuo

# 中转站 Key（可选：BYOK 模式下客户自带 key，此为开发/调试用默认 key）
# SUBLYX_API_KEY=sk-你的key

# 中转站地址（已内置 https://api.sublyx.org/v1，一般无需覆盖）
# RELAY_BASE=https://api.sublyx.org/v1

# 默认模型（客户不选时用的模型）
# RELAY_MODEL=gpt-5.5

# 端口（next start 用）
# PORT=3000
